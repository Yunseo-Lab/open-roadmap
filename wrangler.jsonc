{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "loadmap",
  "main": "src/backend/index.ts",
  "compatibility_date": "2026-04-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "loadmap-db",
      "database_id": "5d347a34-44b8-470f-8f5e-470bea259503"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "loadmap-files"
    }
  ],
  "vars": {
    "APP_ENV": "development",
    "BETTER_AUTH_URL": "https://loadmap.yunseo-tech.workers.dev",
    "OPENROUTER_MODEL": "openai/gpt-4.1-mini",
    "AI_SERVICE_URL": ""
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
