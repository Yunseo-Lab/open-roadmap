{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "open-roadmap",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "open-roadmap.yunseo-lab.com", "custom_domain": true }],
  "main": "src/backend/index.ts",
  "compatibility_date": "2026-04-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-roadmap-db",
      "database_id": "f799cb64-e2f6-465c-9257-d30cf40a2edd"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "open-roadmap-files"
    }
  ],
  "vars": {
    "APP_ENV": "development",
    "BETTER_AUTH_URL": "https://open-roadmap.yunseo-lab.com",
    "OPENROUTER_MODEL": "openai/gpt-4.1-mini",
    "AI_SERVICE_URL": "https://open-roadmaps.duckdns.org"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
